NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key is supported as a fallback.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAPPLS_API_KEY=
ORS_API_KEY=
NEXT_PUBLIC_ADMIN_EMAILS=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SECRET_KEY=

PAYMENT_MODE=razorpay

# Server-only Razorpay test credentials; use the matching pair from Test Mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Must match the payment.captured webhook configured in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# Web Push: generate a matching pair with node scripts/setup-journey-push.mjs.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-production-domain.example
# Protects POST /api/push/dispatch for a server scheduler to retry queued alerts.
JOURNEY_DISPATCH_SECRET=
